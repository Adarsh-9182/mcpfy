{
  "name": "mcpfy-typescript-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcpfyy/mcpfy.git",
    "directory": "typescript"
  },
  "scripts": {
    "build": "pnpm --filter mcpfy-sdk build && pnpm --filter create-mcpfy-app build",
    "build:platform": "pnpm --filter @mcpfy/web build",
    "dev": "pnpm --filter @mcpfy/web dev",
    "db:generate": "pnpm --filter @mcpfy/db generate",
    "db:migrate": "pnpm --filter @mcpfy/web db:migrate",
    "test": "pnpm --filter mcpfy-sdk test && pnpm --filter @mcpfy/db test && pnpm --filter @mcpfy/detection test && pnpm --filter @mcpfy/deployment test",
    "typecheck": "pnpm -r --filter @mcpfy/db --filter @mcpfy/ui --filter @mcpfy/detection --filter @mcpfy/deployment --filter @mcpfy/web typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
