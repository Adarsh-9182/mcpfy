  },
  "bugs": { "url": "https://github.com/mcpfyy/mcpfy/issues" },
  "keywords": [
    "mcp",
    "mcpfy",
    "model-context-protocol",
    "audit",
    "lint",
    "validate",
    "inspector",
    "ci",
    "cli"
  ],
