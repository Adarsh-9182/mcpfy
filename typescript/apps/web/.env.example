# Leave DATABASE_URL unset to use PGlite (in-process Postgres, no setup).
# Point it at a real Postgres for anything shared or deployed.
# DATABASE_URL=postgres://user:password@localhost:5432/mcpfy
DATABASE_URL=pglite://.pgdata

# Required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
SECRET_ENCRYPTION_KEY=

BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — enables "Continue with GitHub" and repository import (§10).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
