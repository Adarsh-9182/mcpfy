# A real PostgreSQL, started by `pnpm db:up` from typescript/ — no Docker
# needed, the binaries come from npm. This is the default because MCPfy runs
# background deployments alongside HTTP requests, and two writers is the
# normal case here.
DATABASE_URL=postgres://mcpfy:mcpfy@localhost:5433/mcpfy

# PGlite (Postgres compiled to WASM, in-process, zero setup) is still
# available for a single-process throwaway run. It cannot take concurrent
# writers: a second process aborts the WASM instance and the data with it.
# DATABASE_URL=pglite://.pgdata

# Required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
SECRET_ENCRYPTION_KEY=

BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional sign-in methods. Each button only appears when its pair is set —
# a "Continue with Google" that 500s reads as a broken product rather than an
# unconfigured one.
#
# GitHub:  github.com/settings/developers -> New OAuth App
#          Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google:  console.cloud.google.com -> APIs & Services -> Credentials
#          Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional - password reset and email verification.
# Leave unset in development and the link is printed to the server log
# instead of being sent, so the whole flow is testable with nothing
# configured. Required in production, where a missing provider is an error
# rather than a silent no-op.
RESEND_API_KEY=
EMAIL_FROM="MCPfy <noreply@yourdomain.com>"

# The local runtime executes repository build and start commands directly on
# this machine with no sandbox. Safe for development and self-hosting your own
# code; never enable it on a host that builds other people's repositories.
MCPFY_ALLOW_LOCAL_RUNTIME=0
# Where deployment checkouts live (default: ~/.mcpfy/deployments).
# MCPFY_WORKSPACE_ROOT=

# Optional - billing. Without these, everyone is on the Free plan and limits
# are still enforced; only upgrading is unavailable.
#   dashboard.stripe.com/apikeys           -> STRIPE_SECRET_KEY
#   dashboard.stripe.com/webhooks          -> STRIPE_WEBHOOK_SECRET
#     endpoint: https://your-domain/api/stripe/webhook
#     events:   customer.subscription.created, .updated, .deleted
#   dashboard.stripe.com/products          -> one recurring price per plan
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_HOBBY=
STRIPE_PRICE_STARTUP=
